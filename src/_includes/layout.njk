<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Beratungswerk Breisgau - Beratungsdienstleistungen für Kommunen und Unternehmen">
  <title>{{ title | default("Beratungswerk Breisgau") }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="header-container">
      <div class="header-title">Beratungswerk Breisgau</div>
      <nav>
        <ul>
          {% for page in site.nav %}
            <li><a href="{{ page.url }}" {% if page.url == page.url %}{% endif %}>{{ page.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <div class="container">
      {{ content | safe }}
    </div>
  </main>

  <footer>
    <div class="footer-content">
      <p>&copy; 2024 Beratungswerk Breisgau. All rights reserved.</p>
      <p>Email: <a href="mailto:info@beratungswerk-breisgau.de">info@beratungswerk-breisgau.de</a></p>
      <p><a href="/impressum/">Impressum</a></p>
    </div>
  </footer>
</body>
</html>
